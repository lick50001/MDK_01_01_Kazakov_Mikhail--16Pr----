<Page x:Class="Submission_of_Applications_Kazakov.Pages.Education"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Submission_of_Applications_Kazakov.Pages"
      mc:Ignorable="d" d:DesignWidth="792"
      Title="Подача заявлений" Height="457" MinHeight="475" MinWidth="792">

    <Grid Background="#F8F9FA">
        <Grid Background="White" Height="55" VerticalAlignment="Top">
            <Image HorizontalAlignment="Left" Height="40" Margin="10,10,0,0" VerticalAlignment="Top" Width="40" 
                   Source="C:\Users\student-a502.PERMAVIAT\Desktop\Submission of Applications_Kazakov\Submission of Applications_Kazakov\aooshchepkov.jpg"/>
            <Label Content="Электронная приемная компания" HorizontalAlignment="Left" Margin="55,1,0,0" VerticalAlignment="Top" FontWeight="Bold" FontSize="19"/>
            <Label Content="Перского авиационного техникума им. А. Д. Швецова" Margin="55,24,80,0" VerticalAlignment="Top"/>
            <Label Content="Сведения об образовании" HorizontalAlignment="Left" Margin="10,70,0,0" VerticalAlignment="Top" FontWeight="Bold"/>
        </Grid>

        <Grid Margin="0,60,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="31*"/>
                <ColumnDefinition Width="35*"/>
            </Grid.ColumnDefinitions>
            <Label Content="База:" HorizontalAlignment="Left" Margin="10,40,0,0" VerticalAlignment="Top"/>
            <Label Content="Выберите один из вариантов:" HorizontalAlignment="Left" Margin="10,60,0,0" VerticalAlignment="Top" Foreground="Red"/>
            <RadioButton Content="9 классов" GroupName="Base" HorizontalAlignment="Left" Margin="15,80,0,0" VerticalAlignment="Top"/>
            <RadioButton Content="11 классов" GroupName="Base" HorizontalAlignment="Left" Margin="15,100,0,0" VerticalAlignment="Top"/>
            <RadioButton Content="СПО" GroupName="Base" HorizontalAlignment="Left" Margin="15,120,0,0" VerticalAlignment="Top"/>
            <RadioButton Content="ВПО" GroupName="Base" HorizontalAlignment="Left" Margin="15,140,0,0" VerticalAlignment="Top"/>

            <Label Content="Выберите один из вариантов:" HorizontalAlignment="Left" Margin="10,160,0,0" VerticalAlignment="Top" Foreground="Red"/>
            <RadioButton Content="Аттестат" GroupName="Document" HorizontalAlignment="Left" Margin="15,190,0,0" VerticalAlignment="Top"/>
            <RadioButton Content="Диплом" GroupName="Document" HorizontalAlignment="Left" Margin="15,210,0,0" VerticalAlignment="Top"/>

            <Label Content="Серия и номер документа об образовании:" Margin="10,230,11,0" VerticalAlignment="Top" RenderTransformOrigin="0.5,0.5">
                <Label.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform Angle="-0.07"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Label.RenderTransform>
            </Label>
            <TextBox Height="24" Margin="10,260,10,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top"/>

            <Label Content="Средний балл (до сотых):" Margin="8,230,10,0" VerticalAlignment="Top" Grid.Column="1"/>
            <TextBox Height="24" Margin="9,260,9,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Grid.Column="1"/>

            <Label Content="Прикрепите сканы страниц документа об образовании с Ф.И.О., наименованием образовательной организации и оценками" 
                   HorizontalAlignment="Left" Margin="10,290,0,0" VerticalAlignment="Top" Width="500" Grid.ColumnSpan="2"/>
            <Label Content="(формат документов должен быть PNG, JPEG или PDF, с максимальным размером каждого файла 5 МБ)" 
                   HorizontalAlignment="Left" Margin="10,314,0,0" VerticalAlignment="Top" FontStyle="Italic" FontSize="10"
                   Foreground="Red" Grid.ColumnSpan="2" Width="515"/>

            <Button Content="Выбрать..." Click="BrowsePassport_Click" HorizontalAlignment="Right" Margin="0,339,10,0" VerticalAlignment="Top" Width="80" Height="24" Grid.Column="1"/>
            <TextBox Height="24" Margin="10,339,95,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Grid.ColumnSpan="2"/>

            <Button Click="NextButton" Content="Продолжить" Margin="0,0,10,5" VerticalAlignment="Bottom" Height="25" Grid.Column="1" HorizontalAlignment="Right" Width="150"/>
        </Grid>
    </Grid>
</Page>
