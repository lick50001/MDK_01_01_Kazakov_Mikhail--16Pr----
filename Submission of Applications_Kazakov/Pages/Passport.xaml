<Page x:Class="Submission_of_Applications_Kazakov.Pages.Passport"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Submission_of_Applications_Kazakov.Pages"
      mc:Ignorable="d" d:DesignWidth="800"
      Title="Подача заявлений" Height="642">

    <Grid Background="#F8F9FA">
        <!-- Шапка -->
        <Grid Margin="0,0,0,582" Background="White">
            <Image Source="C:\Users\student-a502.PERMAVIAT\Desktop\Submission of Applications_Kazakov\Submission of Applications_Kazakov\aooshchepkov.jpg"
                   HorizontalAlignment="Left" Height="40" Margin="10,10,0,0" VerticalAlignment="Top" Width="40"/>
            <Label Content="Электронная приемная компания" HorizontalAlignment="Left" Margin="55,1,0,0" VerticalAlignment="Top" 
                   FontWeight="Bold" FontSize="19"/>
            <Label Content="Пермского авиационного техникума им. А. Д. Швецова" Margin="55,24,80,0" VerticalAlignment="Top" FontStyle="Italic"/>
        </Grid>

        <!-- Основной контент -->
        <Grid Margin="0,60,0,0">
            <TextBlock Text="Паспортные данные:" FontWeight="Bold" Margin="10,10,0,10"/>

            <!-- Grid для всех полей -->
            <Grid Margin="10,35,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. ФИО -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="240"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <Label Content="Фамилия:"/>
                        <TextBox Height="24" Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Label Content="Имя:"/>
                        <TextBox Height="24" Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <Label Content="Отчество:"/>
                        <TextBox Height="24" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- 2. Дата рождения -->
                <Grid Grid.Row="1">
                    <Label Content="Дата рождения:"/>
                    <TextBox Height="24" Margin="0,25,0,0"/>
                </Grid>

                <!-- 3. Гражданство -->
                <Grid Grid.Row="2">
                    <Label Content="Гражданство:"/>
                    <TextBox Height="24" Margin="0,25,0,0"/>
                </Grid>

                <!-- 4. Место рождения -->
                <Grid Grid.Row="3">
                    <Label Content="Место рождения:"/>
                    <TextBox Height="24" Margin="0,25,0,0"/>
                </Grid>

                <!-- 5. Серия, дата выдачи, код подразделения -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="240"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <Label Content="Серия и номер паспорта:"/>
                        <TextBox Height="24" Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Label Content="Дата выдачи:"/>
                        <TextBox Height="24" Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <Label Content="Код подразделения:"/>
                        <TextBox Height="24" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- 6. Кем выдан -->
                <Grid Grid.Row="5">
                    <Label Content="Кем выдан:"/>
                    <TextBox Height="24" Margin="0,25,0,0"/>
                </Grid>

                <!-- 7. Адрес по прописке + Район -->
                <Grid Grid.Row="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="480"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="240"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <Label Content="Адрес по прописке:"/>
                        <TextBox Height="24" Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Label Content="Район:"/>
                        <TextBox Height="24" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- 8. Адрес проживания фактический + Район -->
                <Grid Grid.Row="7">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="480"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="240"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <Label Content="Адрес проживания фактический:"/>
                        <TextBox Height="24" Margin="0,5,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Label Content="Район:"/>
                        <TextBox Height="24" Margin="0,5,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- 9. Прикрепление сканов -->
                <Grid Grid.Row="8">
                    <TextBlock Text="Прикрепите сканы страниц паспорта с фотографией и действующей пропиской" 
                               FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock Text="(Формат документов должен быть PNG, JPEG или PDF, а максимальный размер каждого файла 5 МБ)" 
                               Foreground="Red" FontStyle="Italic" Margin="0,20,0,10"/>
                </Grid>

                <!-- 10. Поле выбора файла -->
                <Grid Grid.Row="9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Name="PassportScanTextBox" Height="24" Margin="0,0,10,0"/>
                    <Button Content="Выбрать..." Click="BrowsePassport_Click" Grid.Column="1" Height="24"/>
                </Grid>

                <!-- 11. Кнопка "Продолжить" -->
                <Button Content="Продолжить" Grid.Row="18" HorizontalAlignment="Left" Margin="620,16,0,0" 
                        VerticalAlignment="Top" Width="150" Height="25" Click="Continue_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Page>
